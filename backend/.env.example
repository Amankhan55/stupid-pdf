# Copy this file to .env and fill in real values. .env is gitignored.

# Contact form email delivery, via the Resend HTTP API (not raw SMTP —
# Render blocks outbound SMTP ports 25/465/587 on every plan, so an HTTPS
# API is required). Sign up at https://resend.com with the same address
# as GMAIL_ADDRESS below to send from the shared onboarding@resend.dev
# sender without needing to verify a domain.
RESEND_API_KEY=

# Inbox that receives contact-form submissions.
GMAIL_ADDRESS=

# Comma-separated list of allowed frontend origins for CORS.
# Defaults to "*" (all origins) if unset.
ALLOWED_ORIGINS=

# Set to "true" to enable uvicorn auto-reload when running `python main.py` locally.
DEBUG=
