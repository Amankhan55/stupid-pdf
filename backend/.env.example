# Copy this file to .env and fill in real values. .env is gitignored.

# Backend host to send/receive contact-form emails via Gmail SMTP.
# Generate an app password at https://myaccount.google.com/apppasswords
# (requires 2FA enabled on the account).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Comma-separated list of allowed frontend origins for CORS.
# Defaults to "*" (all origins) if unset.
ALLOWED_ORIGINS=

# Set to "true" to enable uvicorn auto-reload when running `python main.py` locally.
DEBUG=
